#!/usr/bin/env bash
# Restore a minimized window to its origin workspace and focus it.
#
#   omarchy-restore-minimized                 # newest minimized window
#   omarchy-restore-minimized 0xADDRESS       # a specific minimized window
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
STATE_HELPER="$SCRIPT_DIR/windowcontrols_state.py"
MAX_COMPOSITOR_BYTES=$((256 * 1024))
target="${1:-}"

if (( $# > 1 )); then
  printf 'Usage: %s [0xADDRESS]\n' "${0##*/}" >&2
  exit 2
fi

if [[ -n $target && ! $target =~ ^0x[0-9A-Fa-f]{1,16}$ ]]; then
  printf '%s: invalid window address: %s\n' "${0##*/}" "$target" >&2
  exit 2
fi

# Ask the same authoritative list used by the bar. It filters the stack
# against windows actually parked on special:minimized before we choose one.
windows=$("$SCRIPT_DIR/omarchy-minimized-list")

if [[ -z $target ]]; then
  addr=$(jq -r '.[0].address // empty' <<<"$windows")
  [[ -n $addr ]] || exit 0
else
  addr="$target"
  jq -e --arg address "$addr" 'any(.[]; .address == $address)' \
    <<<"$windows" >/dev/null || exit 0
fi

# Use the most recently recorded, strictly validated origin. A hand-parked
# window has no record, so return it to the workspace in front of the user.
ws=$("$STATE_HELPER" take "$addr")
if [[ -z $ws ]]; then
  active_workspace=$(set -o pipefail; timeout 2s hyprctl activeworkspace -j | head -c "$((MAX_COMPOSITOR_BYTES + 1))") || {
    printf '%s: could not read the active workspace safely\n' "${0##*/}" >&2
    exit 1
  }
  if (( ${#active_workspace} > MAX_COMPOSITOR_BYTES )); then
    printf '%s: active-workspace response exceeds the safety limit\n' "${0##*/}" >&2
    exit 1
  fi
  ws=$(jq -er '
    select(type == "object")
    | .id
    | select(type == "number" and . == floor and . >= -2147483648 and . <= 2147483647)
    | tostring
  ' <<<"$active_workspace")
fi

if [[ ! $ws =~ ^-?(0|[1-9][0-9]{0,9})$ ]]; then
  printf '%s: invalid workspace id in state\n' "${0##*/}" >&2
  exit 1
fi

timeout 2s hyprctl eval "
hl.dispatch(hl.dsp.window.tag({ tag = \"-omarchy_windowcontrols_origin_$ws\", window = \"address:$addr\" }))
hl.dispatch(hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\", follow = false }))
hl.dispatch(hl.dsp.focus({ window = \"address:$addr\" }))
" >/dev/null
