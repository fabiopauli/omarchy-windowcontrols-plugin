#!/usr/bin/env bash
# Restore a minimized window to its origin workspace and focus it.
#
#   omarchy-restore-minimized                 # newest minimized window
#   omarchy-restore-minimized 0xADDRESS       # a specific minimized window
set -euo pipefail

STATE_FILE="$HOME/.cache/hypr-minimized-stack"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target="${1:-}"

if (( $# > 1 )); then
  printf 'Usage: %s [0xADDRESS]\n' "${0##*/}" >&2
  exit 2
fi

if [[ -n $target && ! $target =~ ^0x[0-9A-Fa-f]+$ ]]; then
  printf '%s: invalid window address: %s\n' "${0##*/}" "$target" >&2
  exit 2
fi

# Ask the same authoritative list used by the bar. It filters the stack
# against windows actually parked on special:minimized before we choose one.
windows=$("$SCRIPT_DIR/omarchy-minimized-list")

if [[ -z $target ]]; then
  addr=$(jq -r '.[0].address // empty' <<<"$windows")
  [[ -n $addr ]] || exit 0
else
  addr="$target"
  jq -e --arg address "$addr" 'any(.[]; .address == $address)' \
    <<<"$windows" >/dev/null || exit 0
fi

# Use the most recently recorded origin. A hand-parked window has no stack
# record, so return it to the workspace currently in front of the user.
ws=$(awk -v address="$addr" '$1 == address { workspace = $2 } END { if (workspace != "") print workspace }' \
  "$STATE_FILE" 2>/dev/null || true)
[[ -n $ws ]] || ws=$(hyprctl activeworkspace -j | jq -r '.id')

if [[ -f $STATE_FILE ]]; then
  state_tmp=$(mktemp "${STATE_FILE}.tmp.XXXXXX")
  trap 'rm -f -- "${state_tmp:-}"' EXIT
  awk -v address="$addr" '$1 != address' "$STATE_FILE" >"$state_tmp"
  mv -f -- "$state_tmp" "$STATE_FILE"
  trap - EXIT
fi

hyprctl eval "
hl.dispatch(hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\", follow = false }))
hl.dispatch(hl.dsp.focus({ window = \"address:$addr\" }))
" >/dev/null
