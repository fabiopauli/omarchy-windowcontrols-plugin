#!/usr/bin/env bash
# Print the windows actually parked on special:minimized as compact JSON,
# newest first. The stack supplies ordering and origin workspaces only.
set -euo pipefail

STATE_FILE="$HOME/.cache/hypr-minimized-stack"
dry_run=0

case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  -h|--help)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}"
    printf '  --dry-run  derive and print the list without pruning the stack file\n'
    exit 0
    ;;
  *)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

if (( $# > 1 )); then
  printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
  exit 2
fi

clients=$(hyprctl clients -j)
live=$(jq -r '.[] | select(.workspace.name == "special:minimized") | .address' <<<"$clients")
pruned=""

if [[ -f $STATE_FILE ]]; then
  # Keep only live addresses and only the newest stack entry per address.
  pruned=$(printf '%s\n' "$live" | awk '
    NR == FNR { if ($0 != "") alive[$0] = 1; next }
    $1 in alive { keep[$1] = $0; order[$1] = FNR }
    END { for (address in keep) print order[address] "\t" keep[address] }
  ' - "$STATE_FILE" | sort -n | cut -f2-)

  if (( ! dry_run )); then
    state_tmp=$(mktemp "${STATE_FILE}.tmp.XXXXXX")
    trap 'rm -f -- "${state_tmp:-}"' EXIT
    if [[ -n $pruned ]]; then
      printf '%s\n' "$pruned" >"$state_tmp"
    else
      : >"$state_tmp"
    fi
    mv -f -- "$state_tmp" "$STATE_FILE"
    trap - EXIT
  fi
fi

order=$(awk '{print $1}' <<<"$pruned" | tac)

jq -c --arg order "$order" '
  ($order | split("\n") | map(select(length > 0))) as $ord
  | map(select(.workspace.name == "special:minimized")
        | {address, class, title, pid, initialClass, initialTitle})
  | . as $wins
  | (map(.address)) as $addrs
  | ([$ord[] | select(. as $address | $addrs | index($address))]
     + [$addrs[] | select(. as $address | $ord | index($address) | not)]) as $sorted
  | [$sorted[] as $address | ($wins[] | select(.address == $address))]
' <<<"$clients"
