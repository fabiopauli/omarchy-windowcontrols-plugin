#!/usr/bin/env bash
# Remember the focused window's workspace, then park it on the shared
# special:minimized workspace. Paired with omarchy-restore-minimized.
set -euo pipefail

mkdir -p -- "$HOME/.cache"

hyprctl eval '
local w = hl.get_active_window()
if w then
  local f = assert(io.open(os.getenv("HOME") .. "/.cache/hypr-minimized-stack", "a"))
  f:write(w.address .. " " .. tostring(w.workspace.id) .. "\n")
  f:close()
  hl.dispatch(hl.dsp.window.move({ window = "address:" .. w.address, workspace = "special:minimized", follow = false }))
end
' >/dev/null
